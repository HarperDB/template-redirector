{
	"name": "template-redirector",
	"version": "3.0.1",
	"description": "Harper Redirector Component Template",
	"type": "module",
	"author": {
		"name": "HarperDB, Inc.",
		"email": "opensource@harperdb.io",
		"url": "https://harper.fast/"
	},
	"prettier": "@harperdb/code-guidelines/prettier",
	"scripts": {
		"dev": "harper dev .",
		"start": "harper run .",
		"format": "prettier --write .",
		"test": "npx vitest run  --config .github/config/vitest.config.js",
		"test:integration": "HARPER_INTEGRATION_TEST_INSTALL_SCRIPT=./node_modules/harper/dist/bin/harper.js harper-integration-test-run --isolation=none \"integrationTests/**/*.test.ts\"",
		"postinstall": "npm link harper"
	},
	"dependencies": {
		"harper": "^5.0.11",
		"papaparse": "5.5.3"
	},
	"devDependencies": {
		"@harperdb/code-guidelines": "0.0.6",
		"@harperfast/integration-testing": "^0.3.1",
		"@types/node": "^22.0.0",
		"@vitest/coverage-v8": "4.0.18",
		"dotenv": "17.2.1",
		"prettier": "3.8.1",
		"supertest": "7.2.2",
		"vitest": "4.0.18"
	},
	"license": "Apache-2.0"
}
